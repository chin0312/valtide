OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Alpaca — configured underlying equity symbol (same provider/feed family).
# Free accounts must use feed=iex; sip needs a paid data plan.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# Reference under test: OKX X-Perp NVDA index (public v5 endpoint, no key needed)
OKX_XPERP_INDEX_ID=NVDA-USD

# Optional explicit NVDAx deployment overrides. Blank uses the registered
# Solana chainIndex/address; if set, both values must match that identity.
OKX_NVDAX_CHAIN_INDEX=
OKX_NVDAX_TOKEN_ADDRESS=

# DexScreener — optional diagnostic / future cross-check source (not canonical)
DEXSCREENER_NVDAX_ADDRESS=Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh

# Warmed live runtime (disabled by default for local/test safety)
LIVE_SCHEDULER_ENABLED=false
LIVE_SCHEDULER_ASSET=NVDAx
# Optional explicit multi-worker list. Leave blank for the compatible single
# asset setting above; select only assets with verified model/data readiness.
LIVE_SCHEDULER_ASSETS=
LIVE_SETTLEMENT_GRACE_SECONDS=60
LIVE_SETTLEMENT_MAX_ATTEMPTS=5
LIVE_SETTLEMENT_RETRY_DELAY_SECONDS=15
VALTIDE_STATE_DB_PATH=data/runtime/valtide.sqlite3
HISTORICAL_PANEL_PATH=data/generated/nvdax_historical_5m.csv
# Optional asset-bound panels; unset means unavailable (never inherits NVDAx).
SPYX_HISTORICAL_PANEL_PATH=
QQQX_HISTORICAL_PANEL_PATH=
AAPLX_HISTORICAL_PANEL_PATH=
TSLAX_HISTORICAL_PANEL_PATH=
LIVE_UNDERLYING_MAX_AGE_SECONDS=360
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Contract deployment / admin only. These are not backend runtime signer values.
DEPLOYER_PRIVATE_KEY=
PUBLISHER_ADDRESS=

# Backend X Layer publisher. Keep the private key local and never commit it.
PUBLISHER_PRIVATE_KEY=
XLAYER_RPC_URL=
XLAYER_CHAIN_ID=1952
REGISTRY_ADDRESS=
RISK_GUARD_ADDRESS=
DEMO_VAULT_ADDRESS=
PUBLISH_VALIDITY_SECONDS=900
PUBLISH_ENABLED=false
AUTO_PUBLISH_ENABLED=false
